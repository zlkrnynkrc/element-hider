{
  "manifest_version": 3,
  "name": "Element Hider",
  "version": "1.1",
  "description": "Sayfadaki elementleri seçip gizleyin",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Element Hider"
  }
}